---
/**
 * SOCIAL ICONS — owner, 22 Sep 2026: "here are social icons so you can use the
 * ones you need to make the links the buttons instead of text."
 *
 * Inline SVG rather than image files, for three reasons:
 *   - no request and no bytes beyond the markup, on every one of 438 pages;
 *   - they inherit the footer's ink through currentColor, so they cannot
 *     drift out of contrast when the palette moves;
 *   - the owner's sheet was a screenshot of an icon sheet. Tracing a
 *     screenshot gives you a fuzzy copy of somebody else's export.
 *
 * WHERE THE SHAPES COME FROM. Every mark except Nextdoor is the official
 * glyph published by Simple Icons (CC0; the trademarks remain the networks'
 * own, and linking to a profile is what they are for). I drew these by hand
 * first and the drawings rendered acceptably — but "acceptably" is not a
 * standard to hold a company's logo to when the exact outline is a fetch
 * away. Nextdoor is the exception: Simple Icons publishes their full
 * wordmark, which is unreadable at 22px, so the hooked n from the owner's own
 * sheet is drawn here.
 *
 * ONE COLOR, ON PURPOSE. Brand-colored badges would put eight competing logos
 * at the foot of every page, and the Instagram gradient in particular reads as
 * an advert. Monochrome marks sit as a quiet row and each is still the shape
 * people recognize.
 *
 * NAMED, NOT JUST DRAWN. Each icon is decorative markup (aria-hidden) beside
 * real text that is visually hidden but present in the DOM: an unlabeled icon
 * is a guess for anyone using a screen reader, and aria-label alone is not
 * read by every translation tool. The link is 44px square, so each mark is a
 * tap target in its own right.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
---
{name === 'Facebook' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <path
      fill="currentColor"
      d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
    />
  </svg>
)}
{/* Instagram is the one official glyph left out: its published outline is a
    2,000-character trace of the same rounded square, lens and dot that four
    primitives draw exactly, at a twentieth of the markup, on every page. */}
{name === 'Instagram' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <rect x="2.2" y="2.2" width="19.6" height="19.6" rx="5.6" fill="none" stroke="currentColor" stroke-width="2.1" />
    <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="2.1" />
    <circle cx="17.6" cy="6.4" r="1.5" fill="currentColor" />
  </svg>
)}
{name === 'LinkedIn' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <path
      fill="currentColor"
      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
    />
  </svg>
)}
{name === 'Nextdoor' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    {/* The hooked lowercase n from the owner's sheet, as two strokes rather
        than a filled outline: the hook is the whole character of the mark and
        a stroke lets it be shaped directly. Two earlier fills got it wrong —
        a spike, then something that read as an h — which is why each attempt
        was checked against a render rather than assumed. */}
    {/* Scaled to fill the 24-unit box: at the size it was first drawn, the n
        sat visibly smaller than the marks either side of it in the row. */}
    <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.9 7.2a3.2 3.2 0 0 1 3.2 3.2v10.1" />
      <path d="M7.1 13.4a5.3 5.3 0 0 1 10.6 0v7.1" />
    </g>
  </svg>
)}
{name === 'TikTok' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <path
      fill="currentColor"
      d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
    />
  </svg>
)}
{name === 'YouTube' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <path
      fill="currentColor"
      d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
    />
  </svg>
)}
{name === 'Google' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
    <path
      fill="currentColor"
      d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"
    />
  </svg>
)}
