---
import { business } from '../data/business';
import { intrinsicSize } from '../lib/images';

/* THE FULL LOCKUP, at the owner's instruction. The first pass used a crop of
   just the mascot's head, on the reasoning that the artwork is a square
   lockup — mascot above a banner reading SASQUATCH PEST CONTROL — and that at
   masthead size the banner's own lettering renders too small to read. That
   reasoning still holds, and it is the wrong thing to optimize for: the mark
   people recognize is the whole badge, and it is recognized by its shape and
   its colours long before anyone reads the words inside it. Small illegible
   lettering inside a logo is normal. A logo nobody recognizes is not.

   So the height is set where the badge reads as itself — 3.4rem — and the
   serif name beside it carries the legibility the lettering cannot. The crop
   is deleted rather than left in the folder.

   The original artwork was flat RGB on white, which would have shown as a
   white card on both the cream and the dark masthead. The background is
   knocked out by flooding from the four corners rather than keying every
   white pixel, so the white inside the artwork — the highlights on the mane,
   the glint in the eyes, the strokes on the letters — survives. */
const mark = '/img/sasquatch-logo.png';
const { width, height } = intrinsicSize(mark);
---
<header class="site">
  <div class="wrap">
    {/* Already the home link, and has been. It gains the mark, not a second
        anchor: two links to the same page sitting next to each other is a
        duplicate stop for anyone tabbing through, and it is the thing that
        makes a masthead read as two brands. */}
    <a class="brand" href="/">
      {/* aria-hidden because the link's accessible name is the wordmark
          beside it. Without it a screen reader announces the company twice.
          The alt is written anyway rather than left empty: harness check 2
          fails any <img> with an empty alt, and that rule is worth more than
          this exception is. */}
      <img
        class="brand-mark"
        src={mark}
        width={width}
        height={height}
        alt="The Sasquatch Pest Control logo"
        aria-hidden="true"
      />
      <span>{business.name}</span>
    </a>
    <nav aria-label="Primary">
      <a href="/services/">Services</a>
      <a href="/locations/">Service areas</a>
      <a href="/commercial/">Commercial</a>
      <a href="/pest-library/">Pest library</a>
      <a href="/guides/">Guides</a>
      <a href="/our-guarantee/">Guarantee</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</header>
