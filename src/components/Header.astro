---
import { business } from '../data/business';
import { intrinsicSize, srcsetFor } from '../lib/images';
import { t, altPathFor, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' }: Props = Astro.props;
const S = t(lang);

/* THE FULL LOCKUP, at the owner's instruction. The first pass used a crop of
   just the mascot's head, on the reasoning that the artwork is a square
   lockup — mascot above a banner reading SASQUATCH PEST CONTROL — and that at
   masthead size the banner's own lettering renders too small to read. That
   reasoning still holds, and it is the wrong thing to optimize for: the mark
   people recognize is the whole badge, and it is recognized by its shape and
   its colors long before anyone reads the words inside it. Small illegible
   lettering inside a logo is normal. A logo nobody recognizes is not.

   So the height is set where the badge reads as itself — 3.4rem — and the
   serif name beside it carries the legibility the lettering cannot. The crop
   is deleted rather than left in the folder.

   The original artwork was flat RGB on white, which would have shown as a
   white card on both the cream and the dark masthead. The background is
   knocked out by flooding from the four corners rather than keying every
   white pixel, so the white inside the artwork — the highlights on the mane,
   the glint in the eyes, the strokes on the letters — survives. */
const mark = '/img/sasquatch-logo.png';
const { width, height } = intrinsicSize(mark);

/* The sections, as data rather than as hand-written anchors, so the current
   one can be marked without repeating the test once per link.

   WHAT THE AUDIT ON 4 SEP 2026 FOUND, because the fix is only half the story.
   Counting inbound links across all 222 built pages turned up four sections
   that the site chrome reached badly or not at all:

     /blog/          70 inbound links, every single one a breadcrumb from a
                     post inside it. Nothing in the masthead, nothing in the
                     footer. Sixty-four posts, and the only way to the index
                     was to already be in it.
     /what-we-use/   0 links from any page body. Footer colophon only — and it
                     is the strongest trust asset on the site.
     /network/       0 links from any page body. Footer colophon only.
     /gallery/       6 links from page bodies, footer colophon otherwise.
     /about/         6 links from page bodies. Chrome only, otherwise.

   Plus two pages the owner expected to exist and which did not: the awards
   and recognition page (the badges were buried inside /about/) and the
   trusted partners page (a legacy referral page the redirect map had quietly
   pointed at /network/ on a guess). Both are now real pages.

   TWO TIERS, NOT ONE LONGER ROW. Fourteen destinations in one chip row is the
   clutter the owner already objected to once. So the row that answers "what
   do you do and where" stays a grid of chips, and the three pages that are
   read after somebody has decided to look properly sit on a quieter line
   beneath it. Both are plain anchors in the HTML — no menu, no JavaScript, no
   hover state hiding a link from a phone.

   TWELVE IS DELIBERATE. The chips lay out four across above 34rem and three
   across below it, and twelve is the smallest count that divides evenly by
   both. Nine used to give 5 + 4, which left the last row centered under a gap.
   Add or remove a chip here and one of those two grids gets a ragged last row
   — count before you edit, and adjust the basis in §14 if the count moves.

   The three rows are themed rather than alphabetical: what we do, what you
   can read, and how to check us out and get hold of us. */
const NAV = S.nav;

/* The quieter line. These are not lesser pages — the guarantee is the single
   most linked page on this site after the homepage — they are pages somebody
   goes to on purpose rather than while working out what we do. Promoting any
   of them is a one-line move: cut it from here, add it to NAV, and change the
   two divisors in §14 so twelve becomes whatever the new count is. */
const UTILITY_NAV = S.utilityNav;

/* WHICH SECTION AM I IN. The masthead had no answer to that on any of 220
   pages — every link looked identical whether you were on it, under it or
   nowhere near it. That is a wayfinding gap before it is a styling one, and
   on a site this size it is the difference between a masthead and a list.

   Two values, not one, because they mean different things to a screen reader:
   "page" is only correct when this link IS the page you are on, and every
   other match is an ancestor section, which is aria-current="true".

   HOME IS IN THE LIST, and it is the reason for the href !== '/' guard. The
   wordmark has always been the home link and always will be, but a logo being
   clickable is a convention rather than a signal — plenty of people have never
   tried it. Owner's call, and the right one: the cost is one chip.

   The guard is not cosmetic. "/" is a prefix of every path on this site, so
   without it a bare startsWith marks Home as the current section on all 220
   pages and the highlight stops meaning anything at all. Home matches on
   equality only. */
const path = Astro.url.pathname;
const currentFor = (href: string) =>
  path === href ? 'page' : href !== '/' && path.startsWith(href) ? 'true' : undefined;
---
<header class="site">
  <div class="wrap">
    {/* Already the home link, and has been. It gains the mark rather than a
        second anchor beside it: two links to the same page immediately
        adjacent are one duplicate stop for anyone tabbing through, and they
        make a masthead read as two brands. The Home chip in the nav below is
        a different thing — it is a row away, it is labeled, and it exists
        precisely because this one is not labeled. */}
    <a class="brand" href={lang === 'es' ? '/es/' : '/'}>
      {/* aria-hidden because the link's accessible name is the wordmark
          beside it. Without it a screen reader announces the company twice.
          The alt is written anyway rather than left empty: harness check 2
          fails any <img> with an empty alt, and that rule is worth more than
          this exception is. */}
      <img
        class="brand-mark"
        src={mark}
        width={width}
        height={height}
        srcset={srcsetFor(mark)}
        sizes="3.6rem"
        alt="The Sasquatch Pest Control logo"
        aria-hidden="true"
      />
      <span>{business.name}</span>
    </a>
    {/* ONE LANDMARK, TWO ROWS. Two <nav> elements would mean two landmarks to
        skip past and two labels to invent, and a screen reader user gains
        nothing from being told the masthead is in two pieces. It is also the
        shape the word-count auditor expects: harness textOf() strips
        <nav>…</nav> with a lazy match, so a second nav nested or adjacent
        risks it stopping at the first closing tag and counting masthead
        labels as body copy on 224 pages. */}
    <nav aria-label={S.navPrimaryLabel}>
      <div class="nav-main">
        {NAV.map((n) => (
          <a href={n.href} aria-current={currentFor(n.href)}>{n.label}</a>
        ))}
      </div>
      <div class="nav-utility">
        {UTILITY_NAV.map((n) => (
          <a href={n.href} aria-current={currentFor(n.href)}>{n.label}</a>
        ))}
        {/* The language switch sits inside the existing landmark rather than
            in a <nav> of its own — see the one-landmark note above. It only
            renders where a counterpart page actually exists, because a
            switcher that lands on a 404 is worse than no switcher. */}
        {altPathFor(path) && (
          <a class="lang-switch" href={altPathFor(path)} lang={lang === 'es' ? 'en' : 'es'} hreflang={lang === 'es' ? 'en-US' : 'es-US'} aria-label={S.switchToAria}>{S.switchTo}</a>
        )}
      </div>
    </nav>
  </div>
</header>
