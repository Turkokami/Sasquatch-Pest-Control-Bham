---
import { business } from '../data/business';
import { intrinsicSize } from '../lib/images';

/* THE FULL LOCKUP, at the owner's instruction. The first pass used a crop of
   just the mascot's head, on the reasoning that the artwork is a square
   lockup — mascot above a banner reading SASQUATCH PEST CONTROL — and that at
   masthead size the banner's own lettering renders too small to read. That
   reasoning still holds, and it is the wrong thing to optimize for: the mark
   people recognize is the whole badge, and it is recognized by its shape and
   its colours long before anyone reads the words inside it. Small illegible
   lettering inside a logo is normal. A logo nobody recognizes is not.

   So the height is set where the badge reads as itself — 3.4rem — and the
   serif name beside it carries the legibility the lettering cannot. The crop
   is deleted rather than left in the folder.

   The original artwork was flat RGB on white, which would have shown as a
   white card on both the cream and the dark masthead. The background is
   knocked out by flooding from the four corners rather than keying every
   white pixel, so the white inside the artwork — the highlights on the mane,
   the glint in the eyes, the strokes on the letters — survives. */
const mark = '/img/sasquatch-logo.png';
const { width, height } = intrinsicSize(mark);

/* The sections, as data rather than as eight hand-written anchors, so the
   current one can be marked without repeating the test eight times. */
const NAV = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/locations/', label: 'Service areas' },
  { href: '/commercial/', label: 'Commercial' },
  { href: '/pest-library/', label: 'Pest library' },
  { href: '/guides/', label: 'Guides' },
  { href: '/our-guarantee/', label: 'Guarantee' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

/* WHICH SECTION AM I IN. The masthead had no answer to that on any of 220
   pages — every link looked identical whether you were on it, under it or
   nowhere near it. That is a wayfinding gap before it is a styling one, and
   on a site this size it is the difference between a masthead and a list.

   Two values, not one, because they mean different things to a screen reader:
   "page" is only correct when this link IS the page you are on, and every
   other match is an ancestor section, which is aria-current="true".

   HOME IS IN THE LIST, and it is the reason for the href !== '/' guard. The
   wordmark has always been the home link and always will be, but a logo being
   clickable is a convention rather than a signal — plenty of people have never
   tried it. Owner's call, and the right one: the cost is one chip.

   The guard is not cosmetic. "/" is a prefix of every path on this site, so
   without it a bare startsWith marks Home as the current section on all 220
   pages and the highlight stops meaning anything at all. Home matches on
   equality only. */
const path = Astro.url.pathname;
const currentFor = (href: string) =>
  path === href ? 'page' : href !== '/' && path.startsWith(href) ? 'true' : undefined;
---
<header class="site">
  <div class="wrap">
    {/* Already the home link, and has been. It gains the mark rather than a
        second anchor beside it: two links to the same page immediately
        adjacent are one duplicate stop for anyone tabbing through, and they
        make a masthead read as two brands. The Home chip in the nav below is
        a different thing — it is a row away, it is labeled, and it exists
        precisely because this one is not labeled. */}
    <a class="brand" href="/">
      {/* aria-hidden because the link's accessible name is the wordmark
          beside it. Without it a screen reader announces the company twice.
          The alt is written anyway rather than left empty: harness check 2
          fails any <img> with an empty alt, and that rule is worth more than
          this exception is. */}
      <img
        class="brand-mark"
        src={mark}
        width={width}
        height={height}
        alt="The Sasquatch Pest Control logo"
        aria-hidden="true"
      />
      <span>{business.name}</span>
    </a>
    <nav aria-label="Primary">
      {NAV.map((n) => (
        <a href={n.href} aria-current={currentFor(n.href)}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
