---
/** Boilerplate lives HERE, not in page bodies. Keystone Part 6.3:
 *  "Keep boilerplate in components, not bodies. Process/CTA/positioning prose
 *  repeated across pages is the tell." The duplicate-sentence scanner ignores
 *  nothing, so this text must never be pasted into a markdown body.
 *
 *  `market` names the page's own market so the CTA is not generic. */
import { business, isReady } from '../data/business';
import { freeInspectionForSlug, offerLabel } from '../lib/offer';

interface Props { market?: string; service?: string; serviceSlug?: string }
const { market = 'Whatcom County', service, serviceSlug } = Astro.props;

/* THE POLICY AND THE WORDING BOTH MOVED to src/lib/offer.ts, because the
   sticky mobile action bar now makes the same offer and two components
   deciding it separately is exactly the duplication Keystone Part 14 records
   as the most expensive mistake on a prior build. The exception list still
   lives in business.ts; offer.ts reads it. Nothing about which pages get a
   free offer changed — only where the question is answered.

   The label reads "Request a free inspection" as of 2 Sep 2026. The previous
   "Book a free visit" was a cautious softening whose own comment said the
   owner should confirm it and that reverting was one line; the owner asked
   for inspection wording and this is that line. It is permitted copy: see the
   note above INSPECTION_CLAIMS in src/lib/seo.ts, which excludes a general
   free inspection offer from the regulated terms on purpose. */
const offer = offerLabel(freeInspectionForSlug(serviceSlug));
---
<section class="cta" data-boilerplate>
  <h2>{service ? `${service} in ${market}?` : `Pest problem in ${market}?`}</h2>
  <p>
    Family-owned, no long-term contracts, and every treatment is backed by our
    <a href="/our-guarantee/">100% Service Guarantee</a>.
  </p>
  <p>
    <a class="btn" href={`tel:${business.phoneE164}`}>{offer} — {business.phone}</a>
  </p>

</section>
