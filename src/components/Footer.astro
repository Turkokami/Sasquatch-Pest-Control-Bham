---
import { business, isReady, people } from '../data/business';
import { footerServices, categories } from '../data/services';
import { writtenTowns } from '../lib/geo-content';
import { PAGE_PAIRS } from '../data/i18n';
import { esServicios } from '../data/es-servicios';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';

const a = business.address;
/* Every built town, not the first ten. builtTowns() returns thirteen, and the
   three the slice removed were all in Skagit County — which is how Alger,
   Mount Vernon and Sedro-Woolley ended up with six inbound links each and no
   site-chrome links at all, while every Whatcom town had 219. Three more rows
   in a footer column is not a design problem; a county with no chrome links
   is a ranking one. */
/* Written pages only — see writtenTowns() in src/lib/geo.ts. Linking a
   noindex stub from all 227 pages was the bug this replaces. */
const cities = await writtenTowns();
const top = footerServices();
/* WSDA license numbers only. `credential` also carries Jorge Bedoya's 'ACE',
   which is an Entomological Society certification and not a WSDA license at
   all — counting it gave "6 WSDA-licensed applicators" for five. Match the
   LI- prefix rather than merely testing that the field is filled. */
const ratingRead = new Date(business.rating.read).toLocaleDateString(es ? 'es-US' : 'en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const licensedCount = people.filter(
  (p) => p.publishable === true && isReady(p.credential) && /^LI-/.test(p.credential),
).length;

/* THE SPANISH FOOTER, 10 Sep 2026. Until then all twenty-nine Spanish pages
   ended in this footer in English — its headings, its hours, its rating line
   and a column of links into English service pages — beneath a masthead that
   had been careful to link only Spanish ones. Every link here now goes through
   PAGE_PAIRS, so a Spanish reader is sent to a Spanish page where one exists
   and a column fills in by itself as pages land. A town with no Spanish page
   yet is named as plain text rather than linked into English: where we work
   is worth saying, and saying it costs no detour. */
const services = top.map((s) => {
  const en = `/services/${s.slug}/`;
  const esPath = PAGE_PAIRS[en];
  const esLabel = esServicios.find((x) => x.enPath === en)?.nav;
  return es && esPath && esLabel
    ? { href: esPath, label: esLabel }
    : es ? null : { href: en, label: s.short };
}).filter((x): x is { href: string; label: string } => x !== null);

const towns = cities.map((t) => {
  const en = `/locations/${t.slug}/`;
  return { name: t.name, href: es ? PAGE_PAIRS[en] : en };
});

/* The colophon, as data so both languages read one list. /what-we-use/ keeps
   its English link on Spanish pages, marked as English: it is the one page
   deliberately never translated (see i18n.ts — a paraphrased label is not a
   label), and a reader deciding whether to let us apply something should
   still be one click from every label. */
const COLOPHON: { en: string; label: string; es: string }[] = [
  { en: '/gallery/', label: 'Gallery', es: 'Galería' },
  { en: '/blog/', label: 'Blog', es: 'Blog' },
  { en: '/what-we-use/', label: 'What we apply', es: 'Lo que aplicamos (en inglés)' },
  { en: '/awards/', label: 'Awards & press', es: 'Premios y prensa' },
  { en: '/trusted-partners/', label: 'Trusted partners', es: 'Socios de confianza' },
  { en: '/guides/', label: 'Guides', es: 'Guías' },
  { en: '/our-guarantee/', label: 'Guarantee & terms', es: 'Garantía y condiciones' },
  { en: '/network/', label: 'Our network', es: 'Nuestra red' },
];
const colophon = COLOPHON.flatMap((c) => {
  if (!es) return [{ href: c.en, label: c.label }];
  if (PAGE_PAIRS[c.en]) return [{ href: PAGE_PAIRS[c.en], label: c.es }];
  return c.en === '/what-we-use/' ? [{ href: c.en, label: c.es }] : [];
});
---
<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>{business.name}</h3>
        <p>
          {a.street}<br />
          {a.locality}, {a.region} {a.postalCode}<br />
          <a href={`tel:${business.phoneE164}`}>{business.phone}</a><br />
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
        {/* This used to read "WSDA License #<number>" from a company-level
            field that does not exist in this company's structure, and that
            field held the publish gate shut for three days. See the retirement
            note in business.ts.

            What is true, and checkable: the licenses are held per person. So
            the footer counts the licensed staff and points at /about/, where
            each one is named with a number a reader can put into the WSDA
            public search. A number somebody can verify beats a number that
            merely looks official. */}
        {/* Visible and attributed, never structured data — see the note on
            business.rating. Naming Google and carrying the date is what makes
            this checkable rather than decorative, and a rating a reader can
            verify in ten seconds is the only kind worth printing. */}
        {/* THE RATING NOW LINKS TO THE PROFILE IT CAME FROM, 10 Sep 2026.
            The comment above says a rating a reader can verify in ten seconds
            is the only kind worth printing — and until today the reader had to
            go and search for it themselves, which is not ten seconds and which
            most people will not do. A published figure with a one-click route
            to its source is a different claim from the same figure printed on
            its own.

            Still not structured data. The visible-and-attributed rule on
            business.rating has not changed and the link does not change it —
            an AggregateRating node would be us asserting our own score in a
            machine-readable field, which is exactly what that rule refuses. */}
        {isReady(business.rating.value) && isReady(business.rating.count) && (
          <p class="rating">
            {es
              ? `Calificación de ${business.rating.value} de 5 en ${business.rating.count} `
              : `Rated ${business.rating.value} out of 5 from ${business.rating.count} `}
            {isReady(business.gbpUrl) ? (
              <a href={business.gbpUrl as string} rel="nofollow noopener">
                {es ? 'reseñas de Google' : 'Google reviews'}
              </a>
            ) : (
              es ? 'reseñas de Google' : 'Google reviews'
            )}{es ? `, a ${ratingRead}.` : `, as of ${ratingRead}.`}
          </p>
        )}
        {licensedCount > 0 && (
          es ? (
            <p>
              Aplicadores con licencia del WSDA en el equipo:{' '}
              <a href="/es/nosotros/">{licensedCount} — vea sus números de licencia</a>
            </p>
          ) : (
            <p>
              WSDA-licensed applicators on staff:{' '}
              <a href="/about/">{licensedCount} — see their license numbers</a>
            </p>
          )
        )}
      </div>
      <div>
        <h3>{es ? 'Horario' : 'Hours'}</h3>
        <ul>
          <li>{es ? 'Lun–Vie: 8:00 a. m. – 6:00 p. m.' : 'Mon–Fri: 8:00 AM – 6:00 PM'}</li>
          <li>{es ? 'Sáb–Dom: 8:00 a. m. – 4:00 p. m.' : 'Sat–Sun: 8:00 AM – 4:00 PM'}</li>
        </ul>
      </div>
      <div>
        <h3>{es ? 'Servicios' : 'Services'}</h3>
        <ul>
          {services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          <li><a href={es ? '/es/servicios/' : '/services/'}>{es ? 'Todos los servicios' : 'All services'}</a></li>
        </ul>
      </div>
      <div>
        <h3>{es ? 'Áreas de servicio' : 'Service areas'}</h3>
        <ul>
          {towns.map((t) => <li>{t.href ? <a href={t.href}>{t.name}</a> : t.name}</li>)}
          <li><a href={es ? '/es/areas-de-servicio/' : '/locations/'}>{es ? 'Todas las áreas' : 'All areas'}</a></li>
        </ul>
      </div>
    </div>
    {/* Was an inline style="margin-top:2rem;opacity:.7". Two problems with
        it: it was a rule the token block could not reach, and opacity on a
        block dims the links inside it along with the text, which is how a
        colophon quietly stops meeting contrast. Styled in §15 now, with an
        ink of its own and the links left at full strength. */}
    {/* THE BLOG WAS NOT HERE AND WAS NOT IN THE MASTHEAD EITHER. A link audit
        across all 222 built pages on 4 Sep 2026 found /blog/ with seventy
        inbound links, every one of them a breadcrumb from a post inside it:
        sixty-four posts whose index no page outside the blog pointed at. It is
        in the masthead now, and here as well, because a section reachable from
        one place is one edit away from being reachable from none. */}
    <p class="colophon">
      © {new Date().getFullYear()} {business.name}.
      {colophon.map((c) => <> · <a href={c.href}>{c.label}</a></>)}
    </p>
  </div>
</footer>
