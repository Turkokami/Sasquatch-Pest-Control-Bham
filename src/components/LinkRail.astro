---
/** Spoke-and-wheel wiring (M3): links up to parent, in to hub, and laterally
 *  to siblings. A page cut off from the cluster won't pull local rankings —
 *  the live site's 68-page neighborhood tier is orphaned entirely. */
interface Props {
  heading: string;
  links: { href: string; label: string }[];
  /** Lay the buttons out as an auto-fitting grid rather than a two-column
   *  flow. For short labels used as a chooser, not for prose-length titles. */
  grid?: boolean;
  /** Wrapping pill buttons, for a rail shown at the top of a page by QuickNav:
   *  twenty-three services as full-width rows would push the page's content a
   *  screen and a half down on a phone. */
  compact?: boolean;
}
const { heading, links, grid = false, compact = false } = Astro.props;
---
{/* data-boilerplate: a link rail is navigation, not content. The harness
    strips it from both the uniqueness floor and the duplicate-sentence
    scanner, and both exclusions are right. A list of page titles is not
    words a page earned, and two pages in the same cluster necessarily share
    most of their rail — flagging that as duplicate content would mean
    flagging the cluster wiring itself, which is the one thing here we most
    want to keep.

    Added when the blog tier landed: 67 imported posts sharing a six-link
    rail tripped the scanner on three separate sequences. The narrow fix
    would have been to mark the rail only inside the blog template — but
    then the same component counts as content on a service page and does not
    on a blog page, which is exactly the single-source-of-truth split that
    has been the recurring defect in this codebase. So it is marked once,
    here, and every word floor was re-checked against the lower counts. */}
{links.length > 0 && (
  <section class:list={[compact && 'rail-top']} data-boilerplate>
    <h2>{heading}</h2>
    <ul class:list={['rail', grid && 'rail-grid', compact && 'rail-chips']}>
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </section>
)}
