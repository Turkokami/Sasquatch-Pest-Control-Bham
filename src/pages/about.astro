---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import LeadForm from '../components/LeadForm.astro';
import ExpertBlock from '../components/ExpertBlock.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { business, people, isReady, credentialMaintenance } from '../data/business';

const path = '/about/';

/* The team splits two ways and the split is the point, not a layout choice.
   A WSDA license type means the state licenses that person to apply pesticides
   and they are on staff here. Jorge holds an ESA certification, no WSDA
   license, and consults rather than works here — rendering him as a sixth
   technician would claim an employment relationship the data does not carry.
   See OWNER DECISION #3 in business.ts: permission to NAME him is not
   permission to describe him as staff. */
const licensed = people.filter((p) => p.publishable === true && p.licenseType !== null);
const advisers = people.filter((p) => p.publishable === true && p.licenseType === null);

/* THE BADGES THEMSELVES ARE ON /awards/ NOW, moved there 4 Sep 2026. What is
   left here is a counted summary and a link, and the counts are still derived
   rather than typed for the same reason they always were: a hand-typed
   "fourteen awards" is wrong the first time somebody adds a row and nobody
   ever notices. */
const awards = business.awards;
const press = business.press;

/* THE TIER SPLIT SURVIVES THE MOVE, because the summary above the link has to
   carry it. `local-vote` means a named local publication or platform put a
   category to a vote; `directory` means a listing site or ratings aggregator
   issued a badge of its own. Summarizing the two as one number would do, in a
   single sentence, exactly what /awards/ spends two lists avoiding. */
const localVote = awards.filter((a) => a.tier === 'local-vote');
const directory = awards.filter((a) => a.tier === 'directory');
/* A shortlisting is not a win. Pulled out so the page can say so in prose as
   well as label it on the row — this is the single most likely thing in the
   list to drift into "award-winning" the next time somebody edits it. */
const finalists = localVote.filter((a) => a.result !== 'winner');
const voteWins = localVote.filter((a) => a.result === 'winner');

const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven',
  'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen',
  'sixteen', 'seventeen', 'eighteen', 'nineteen', 'twenty'];
const spell = (n: number) => NUMBER_WORDS[n] ?? String(n);
/* Same word, capitalized, for the start of a sentence. Spelled numbers open
   three sentences here and "eleven of them came from" shipped lowercase the
   first time this ran. */
const Spell = (n: number) => {
  const w = spell(n);
  return w.charAt(0).toUpperCase() + w.slice(1);
};

const cm = credentialMaintenance;
/* UTC so an ISO date string cannot slip back a day in a local timezone. */
const cmSourceRead = new Date(cm.source.read).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/* The old /about/ carried three H1s and opened with a 113-word run-on.
   It also asserted "Licensed pest management professional" with no number
   anywhere on the site — that claim does not render until the license
   field is filled (see scripts/pending.mjs). */
/* OWNERSHIP WORDING — SETTLED 2 Sep 2026 by the owner, and the history is
   kept because it explains why two published sources disagree with this page.

   The owner states that Kristofer Elling has taken FULL ownership, and that
   Tyson Elling is now Office Manager. business.ts is updated to match.

   Anyone checking us against the press will find otherwise, so here is why
   that is not an error: the Pest Management Professional article in
   business.press was published on 18 August 2023 and names brothers Tyson and
   Kristofer Elling as the owners, and the Markel feature card captions
   Kristofer as "Co-owner". Both were accurate when they were written. The
   ownership changed afterwards. A 2023 article is a record of 2023, not a
   contradiction of today, and it should not be used to "correct" this page
   back — which is exactly what a future reader comparing the two would
   otherwise be tempted to do.

   What is claimed here is now what the owner states and what nothing
   disputes: he founded it, he owns it, it is family-run.
   40–60 words on the answer (src/lib/seo.ts checkAnswer) — recount on edit.
   This is 49. */
const answer =
  'Sasquatch Pest Control is a family-run pest control and exclusion company in Bellingham, Washington, founded and owned by Kristofer Elling. We work our own routes across Whatcom County rather than dispatching from a regional call center, and every treatment we carry out is backed by our 100% Service Guarantee.';

const faqs = [
  { q: 'Who owns Sasquatch Pest Control?', a: 'Kristofer Elling founded Sasquatch Pest Control and owns it outright. It is run as a family business out of Bellingham, Washington, rather than as a franchise or the branch office of a company headquartered in another state.' },
  { q: 'Is Sasquatch Pest Control locally owned?', a: 'Yes. We are locally owned and operated in Bellingham. Our technicians live in the area and run the routes themselves rather than dispatching from another region.' },
  { q: 'What makes Sasquatch different from a national pest company?', a: 'We do not use long-term contracts, our crews are local, and the person who sets our standards works in the field rather than at a corporate office in another state.' },
];

const canClaim = business.hasLicensedStaff;
---
<BaseLayout
  path={path}
  title="About Sasquatch Pest Control | Bellingham, WA"
  description="Family-owned pest control and exclusion founded by Kristofer Elling, serving Bellingham and Whatcom County with no long-term contracts and a 100% Service Guarantee."
  kind="page"
  faqs={faqs}
  image={{
    src: '/img/sasquatch-team-and-trucks.jpg',
    alt: 'The Sasquatch Pest Control crew standing with two branded service vehicles at sunset',
    width: 1600,
    height: 814,
  }}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path }]}
>
  <h1>About Sasquatch Pest Control</h1>
  <AnswerBox text={answer} />

  {/* THE LEAD FORM SITS HERE, HIGH, and the position is the point.
      It used to hang off the foot of Cta.astro, which put it under three
      thousand words: a reader who had already decided to act had to scroll
      an entire article to find anything to act on. The quick answer still
      leads — it is one short paragraph and the schema's speakable selector
      points at it — and the form comes straight after.
  
      ONE PER PAGE. The GHL loader binds to its iframe by id, so a second
      copy would break both; the CTA at the foot no longer carries one and
      keeps its phone button. The sticky mobile bar jumps to this. */}
  <LeadForm />

  <div class="prose">
    <h2>How it started</h2>
    <p>
      Sasquatch Pest Control was founded in Bellingham to do pest work the way a
      local company can: showing up when we say we will, explaining what we
      found, and standing behind the result without a contract holding anyone in
      place.
    </p>

    {/* THE SHELF MOVED TO /awards/, 4 Sep 2026, on the owner's request, and
        this is the summary that replaces it rather than a second copy of it.
        Nothing here restates a sentence from that page — the duplicate-sentence
        check would catch it, and more to the point a summary that repeats the
        thing it summarizes is not a summary.

        What survives here is the count and the qualification, both generated
        from business.awards so that this paragraph cannot drift out of step
        with the page it points at. */}
    {awards.length > 0 && (
      <>
        <h2>Recognition</h2>
        <p>
          {Spell(awards.length)} award badges and {spell(press.length)} magazine
          features, of which {spell(voteWins.length)} badges were decided by a
          readers' vote in a named local publication or platform and{' '}
          {spell(directory.length)} were issued by directory sites.
          {finalists.length > 0 && (
            <>
              {' '}{Spell(finalists.length)} of the entries is a finalist rather
              than a winner, and it is labeled as one.
            </>
          )}
        </p>
        <p>
          They are listed in full — issuer, year, category and result on every
          row — on our{' '}
          <a href="/awards/">awards, recognition and press page</a>, alongside
          the two free Washington State lookups that let you verify a pest
          control company without taking anybody's word for it.
        </p>
      </>
    )}

    <h2>Our service area</h2>
    <p>
      We work throughout <a href="/locations/">Whatcom County</a> — Bellingham
      and its neighborhoods, plus Ferndale, Lynden, Blaine, Birch Bay, Everson,
      Nooksack, Sumas, Sudden Valley, Custer, Deming and Acme.
    </p>

    <h2>What we believe about this work</h2>
    <p>
      Pest control has a reputation problem, and it is largely earned. The
      industry's worst habits are all variations on the same theme: sell a
      recurring treatment for a problem that a repair would end, describe a
      harmless species as dangerous, and write a guarantee vague enough that it
      never has to be honored.
    </p>
    <p>
      We have built this company around not doing those things, which sometimes
      costs us a sale. When moisture ants turn up in a sill plate, the finding
      that matters is where the water is coming from — and the person who needs
      to hear it is often a contractor rather than us. When someone calls in
      October about a large spider in the bathtub, the honest answer is usually
      that it is a giant house spider doing what they do every autumn and that no
      treatment is warranted. We would rather be the company that told you that
      than the one that sold you a quarterly plan for it.
    </p>
    <p>
      The same applies to the jobs we decline. We do not sell mole trapping,
      because the traps sold for it are prohibited body-gripping traps under
      Washington law. We do not do bird work or nuisance wildlife removal, so if
      that is what you need we will tell you on the phone and point you to
      somebody who does it properly rather than taking the booking. Those
      conversations are harder than saying yes, and they are the reason people
      call us back.
    </p>

    <h2>How we work in the field</h2>
    <p>
      Our technicians live here and run these routes themselves. That is not a
      slogan — it is the reason someone can tell you that the housing stock in the
      Lettered Streets behaves differently from the housing stock in Barkley, or
      that the rodent movement out along the river starts three weeks before it
      does in town.
    </p>
    <p>
      Every job starts with identification, because it drives everything after it.
      Carpenter ants and moisture ants call for genuinely different responses.
      A hobo spider and a giant house spider are routinely confused and only one
      of those confusions leads to unnecessary treatment. Getting the species
      right first is the cheapest thing we do.
    </p>
    <p>
      We put the scope in writing before work starts, we do not require long-term
      contracts, and every treatment carries our
      <a href="/our-guarantee/">100% Service Guarantee</a> — which is a defined
      re-service commitment with published terms rather than an open-ended
      promise.
    </p>

    <h2>The visit that comes first</h2>
    <p>
      Almost nothing in this trade can be honestly priced down a phone line, so
      most jobs open with somebody driving out to look at the actual building.
      {business.freeInspection.default && ' That assessment is free.'} It is free
      because charging for the conversation gives a company a reason to find
      something in it, and because we would rather absorb the drive than talk
      someone into a treatment their house did not need.
    </p>
    <p>
      There is one exception on our list and we would rather name it here than
      have you meet it at the door. Bed bug work carries a paid verification
      visit instead, and it is credited toward the treatment if you go ahead.
      Confirming an active bed bug population is an hour of careful looking
      rather than ten minutes of it, and a wrong call in either direction costs
      the customer far more than the visit does.
    </p>
    <p>
      Two words of precision about what that first visit is. It is a
      pre-service assessment — somebody working out what you have and what it
      would take to deal with it. We do not present it as a wood-destroying
      organism inspection, which is a separately licensed activity in
      Washington and is dealt with below.
    </p>

    <h2>What you get in writing</h2>
    <p>
      Two documents matter here and they are genuinely different documents, so
      it is worth pulling them apart. The first is the scope, and it reaches you
      before anyone treats anything: what we propose to do, where we propose to
      do it, and what it will cost, set down while you can still decline the
      whole thing. Nobody should be reading the plan for their house after the
      truck has left.
    </p>
    <p>
      The second is the record of the treatment performed, and it reaches you
      afterwards. It sets down the material used, the target pest, the areas
      treated and the rate applied, because that is what a label, an auditor, a
      property manager or the next technician on the account will need to know.
      Commercial customers usually want it filed and referenced; a homeowner
      usually wants it once and never thinks about it again. Both are fine, and
      both get the same record.
    </p>
    <p>
      That record has a boundary, and it is a legal one rather than a
      preference. A document identifying damage or infestation by
      wood-destroying organisms is a regulated instrument in this state,
      carrying a state-issued control number and the license number of the
      person who signed it. We are not licensed structural pest inspectors and
      we do not produce that document. An account of the treatment we carried
      out is a different thing doing a different job, and it is the one we can
      hand you.
    </p>

    <h2>Exclusion, and why we invested in it</h2>
    <p>
      Plenty of companies will spray a perimeter on a schedule. Far fewer will go
      under a house on their back with a light and work out how the animal is
      actually getting in. We went the other way and built the exclusion side
      into a specialty, because in a climate this wet the entry point outlasts
      every product on the truck.
    </p>
    <p>
      It is physical work and it is genuinely skilled — knowing which vent screen
      will fail in three winters, which foamed penetration a rat opens in an
      evening, which gap under a garage door matters and which does not. Done
      badly it looks fine and fails by November. Done well it is close to
      invisible and it holds for years.
    </p>
    <p>
      It is also the work that lets us give an honest answer about what is
      actually wrong. A great deal of what we find is a building problem rather
      than a pest problem, and saying so costs us the recurring service and earns
      the next three referrals.
    </p>

    {canClaim && (
      <>
        <h2>Our licensing</h2>
        <p>
          The people who come to your property are licensed applicators, and we
          publish the numbers rather than asking you to take our word for it.
          Each number appears beside the name that holds it further down this
          page, and you can check any of them with the Washington State
          Department of Agriculture directly.
        </p>
        <p>
          We think that should be normal and it is not. The previous version of
          this page said "licensed pest management professional" with no number
          behind it anywhere on the site, which is the industry standard and is
          worth nothing to you. A credential you cannot check is a claim, not a
          credential.
        </p>
        <p>
          Two license types appear in that list, and the difference is worth a
          sentence because it is structural rather than a matter of seniority.
          Washington's Pesticide Application Act defines a
          <strong>commercial pesticide applicator</strong> as a person who
          engages in the business of applying pesticides to the land of
          another, and a <strong>commercial pesticide operator</strong> as an
          employee of such an applicator who uses or supervises the use of
          pesticides. So the applicator license attaches to the business of
          applying and the operator license to the people doing it.
        </p>
        <p>
          Whichever type, every WSDA license on this page carries the same two
          categories:
          <strong>PCO Structural</strong> and <strong>PCO General</strong>. The
          first is the one worth explaining, because it is what covers
          wood-destroying organisms and because the industry is routinely vague
          about where its authority ends.
        </p>
        <p>
          PCO Structural covers the control of pests that attack structural
          material — fungus, termites, carpenter ants and wood-boring beetles.
          That is a treatment category. It is what allows us to deal with an
          active problem in the wood of your building.
        </p>
        <p>
          <strong>We are not licensed structural pest inspectors.</strong> We do
          not issue the wood-destroying organism report that a lender or an
          escrow company relies on in a property sale. That is a separate
          credential and we do not hold it, so if a sale is what you are dealing
          with, the report needs to come from an independent inspector.
        </p>
        <p>
          What we do is the other half. Where that inspector has identified
          dampwood or subterranean termites, carpenter ants, wood-boring
          beetles, moisture ants or a decay fungus condition, our PCO Structural
          category is what lets us carry out the treatment. You are better
          served by those two roles sitting in different hands anyway, because
          the party identifying the problem then has no financial stake in the
          size of the remedy.
        </p>
        <h3>A license is not a one-time exam</h3>
        <p>
          The part of this nobody advertises is that these credentials have to
          be kept alive.
          {cm.renewsAnnually && ' Each of the WSDA licenses listed further down renews every year.'}
          On top of that, Washington runs a {cm.recertYears}-year
          recertification cycle: an applicator or operator earns
          <strong>{cm.recertCredits} continuing education credits</strong> over
          those {cm.recertYears} years — capped at {cm.maxCreditsPerYear} in any
          one calendar year, so the total cannot be crammed into the last of
          them — or faces {cm.alternative} instead.
        </p>
        <p>
          Recertification is due by {cm.deadline} in the final year of the
          cycle. The practical effect of a cap and a deadline together is that
          the learning is spread across working years rather than sat in a
          single afternoon at the end, and it lands on the subjects that
          actually move — label changes, handling and storage rules, and what
          the department has revised since the last time around.
        </p>
        {cm.staffRegisteredUnderCompany && (
          <p>
            Everyone in the licensed crew is on that cycle, and each of those
            WSDA licenses is held by an employee of Sasquatch Pest Control
            registered with the state as such, rather than by a subcontractor
            whose credentials are somebody else's problem. We track the renewals
            and the credits as a matter of course, because a lapsed license is
            not a paperwork issue — it is the difference between a legal
            treatment and an illegal one.
          </p>
        )}
        <p>
          We mention it because "licensed and insured" appears on every pest
          control website in the county and tells you nothing about whether the
          person at your door has learned anything since the day they passed an
          exam. Ask a company how many credits its technicians carried into this
          year and you will learn more from the pause than from the answer.
        </p>
        <p>
          One caveat on the figures themselves, since this page keeps asking you
          to check things. They come from the owner and are corroborated by
          <a href={cm.source.url} rel="nofollow noopener">{cm.source.label}</a>,
          read {cmSourceRead}. WSDA sets the requirement and is the authority
          on it, so if you want the definitive version, take it from the
          department rather than from us — along with any of the license numbers
          we publish.
        </p>
      </>
    )}
    <h2>Where we work</h2>
    <p>
      Bellingham is home, and the rest of Whatcom County is a short drive in every
      direction that matters. We cover the city and its neighborhoods, the ring
      towns of Ferndale and Sudden Valley, the agricultural north around Lynden,
      Everson, Nooksack and Sumas, and the waterfront communities at Blaine, Birch
      Bay and Semiahmoo.
    </p>
    <p>
      We do not claim territory we cannot service properly. Where an address falls
      outside the routes we run, we say so before scheduling rather than adding a
      travel charge afterwards, and where someone else covers that ground better
      we will tell you that too.
    </p>

    <h2>Family-owned, and what that actually changes</h2>
    <p>
      "Family-owned" appears on almost every pest control site in the country, so
      it is worth saying what it changes here rather than using it as decoration.
      It means the family that owns the company answers for the work, and that
      there is no regional manager between a complaint and someone who can fix
      it. It means we can turn down a job on principle without explaining the
      decision to a corporate office. And it means our pricing does not have to
      cover a franchise royalty, a national call center or a marketing budget set
      in another state.
    </p>
    <p>
      It also has limits worth being straight about. We are not open twenty-four
      hours, we are not everywhere at once, and in late August when every wasp
      nest in the county reaches peak size, we prioritize the jobs where someone
      is likely to get stung over the ones that can wait a few days.
    </p>

    <h2>The company we are trying to build</h2>
    <p>
      The measure we care about is whether people call us back and whether they
      send their neighbors. Both of those are earned slowly and lost quickly, and
      neither survives a company that oversells. So the standards are simple: find
      the actual cause, put the price in writing first, say no to work that should
      not be done, and stand behind what we did on terms a customer can read.
    </p>
    <p>
      That is a slower way to grow a pest control company than the alternative,
      and we are fine with it. The businesses in this industry that scale fastest
      tend to do it on recurring plans sold to people who did not need one, and
      the bill for that arrives later as churn and reputation. We would rather
      grow at the speed of work we can stand behind.
    </p>
    <p>
      If you have read this far, the practical next step is simple. Tell us what
      you are seeing, send a photo if you have one, and we will tell you honestly
      whether it needs us.
    </p>

    <h2>Who you will deal with</h2>
    <p>
      Sasquatch is small enough that you will recognize the people who come to
      your property. That is deliberate. Continuity is worth more in this work
      than most customers realize — a technician who saw your crawlspace last
      autumn knows whether the activity is new, and that is context no written
      record captures on its own.
    </p>

    <figure class="team">
      <img
        src="/img/sasquatch-team-and-trucks.jpg"
        alt="The Sasquatch Pest Control crew standing with two branded service vehicles at sunset"
        width="1600"
        height="814"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        The crew and the trucks that run these routes. It is a photograph of
        the actual team rather than a stock image, which ought to be too
        obvious to point out and, in this industry, is not.
      </figcaption>
    </figure>

    <h3>The licensed crew</h3>
    <p>
      These are the people who hold the licenses described above and who do the
      work at your property. Each entry carries the license type, the number and
      the WSDA categories it covers, so every claim on this page can be checked
      against the state's own record rather than taken on trust.
    </p>
  </div>

  {licensed.map((p) => <ExpertBlock slug={p.slug} />)}

  {advisers.length > 0 && (
    <div class="prose">
      <h3>The entomologist we consult</h3>
      <p>
        Identification drives every decision that follows it, and there is a
        point past which a good field technician should stop guessing and ask
        somebody whose training is in the insects themselves. That is what the
        arrangement below is for.
      </p>
      <p>
        Jorge Bedoya is a consulting entomologist who holds the Associate
        Certified Entomologist credential from the Entomological Society of
        America. He reviews species identification and treatment protocols for
        us. Two things about that are worth stating plainly rather than leaving
        for you to assume. He is a consultant and not a member of staff, so he
        does not run routes, attend jobs or supervise the technicians, and the
        ACE credential is a professional certification from a scientific
        society rather than a Washington pesticide license — a different thing
        from the WSDA licenses above, doing a different job.
      </p>
      <p>
        Where it earns its keep is the awkward specimen: an ant that could
        plausibly be two species with different responses, or a protocol worth
        a second opinion before it becomes standard practice on our routes. A
        review by somebody outside the company has the useful property that he
        gains nothing from the answer being the more expensive one.
      </p>
    </div>
  )}

  {advisers.map((p) => <ExpertBlock slug={p.slug} />)}

  <Faq items={faqs} />
  <Cta market="Bellingham" />
</BaseLayout>

{/* No scoped <style> here, on purpose. The team photograph, the badge wall
    and the press list are styled in §20–21 of src/styles/global.css.

    The badge wall in particular is a system problem, not a page problem.
    Sixteen issuers supplied artwork running 225x225 to 900x1926, some on
    white, some on black and one over a photograph, and the only thing that
    makes a set like that read as a shelf rather than a link farm is identical
    geometry: one plate, one image box, one hairline grid. The plate colour
    has to change between light and dark, so it is a token, and the rules that
    depend on it belong next to it rather than in a style block on one page.

    The old rules also carried three !important declarations to beat the
    specificity of the rule sitting next to them. Those are gone; .badges
    .result now simply outranks .badges span. */}
