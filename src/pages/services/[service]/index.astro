---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBox from '../../../components/AnswerBox.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Photo from '../../../components/Photo.astro';
import Training from '../../../components/Training.astro';
import { servicePhotos } from '../../../data/photos';
import Faq from '../../../components/Faq.astro';
import Cta from '../../../components/Cta.astro';
import LinkRail from '../../../components/LinkRail.astro';
import { guideLinksFor } from '../../../lib/guides';
import ExpertBlock from '../../../components/ExpertBlock.astro';
import { liveServices, categories } from '../../../data/services';
import { business } from '../../../data/business';

export async function getStaticPaths() {
  /* Programmatic routing off the data file. Anything off-list 404s cleanly —
     no accidental thin pages. Unconfirmed services never enumerate. */
  return liveServices().map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const path = `/services/${s.slug}/`;

/* Render the markdown body when it exists, fall back to a generated stub.
   All routes stand up first; content pours in waves without a broken site. */
const entries = await getCollection('services', (e) => e.data.service === s.slug);
const entry = entries[0];
const Body = entry ? (await entry.render()).Content : null;
const ready = entry?.data.ready === true;

const title = entry?.data.title ?? `${s.name} in Bellingham, WA`;
const description =
  entry?.data.description ??
  `${s.name} for homes and businesses across Whatcom and Skagit County. No long-term contracts and a 100% Service Guarantee on every treatment.`;
const h1 = entry?.data.h1 ?? `${s.name} in Bellingham & Whatcom County`;
const answer = entry?.data.answer ?? null;
const faqs = entry?.data.faqs ?? [];

const siblings = liveServices()
  .filter((x) => x.category === s.category && x.slug !== s.slug)
  .map((x) => ({ href: `/services/${x.slug}/`, label: x.name }));

const problems = (s.problems ?? []).map((p) => ({
  href: `${path}${p.slug}/`,
  label: p.title,
}));

/* Related guides, resolved from the guides' own relatedTo declarations —
   one list, queried, rather than a second list maintained here. */
const guideLinks = await guideLinksFor(path);
---
<BaseLayout
  path={path}
  title={title}
  description={description}
  kind="service"
  serviceName={s.name}
  noindex={!ready}
  {/* The AnswerBox only renders once the markdown body lands, so the speakable
      selector naming it must be conditional too — see src/lib/schema.ts. */}
  hasAnswer={Boolean(answer)}
  faqs={faqs}
  image={entry?.data.hero}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: s.short, path },
  ]}
>
  <h1>{h1}</h1>

  {answer && <AnswerBox text={answer} />}

  {/* THE LEAD FORM SITS HERE, HIGH, and the position is the point.
      It used to hang off the foot of Cta.astro, which put it under three
      thousand words: a reader who had already decided to act had to scroll
      an entire article to find anything to act on. The quick answer still
      leads — it is one short paragraph and the schema's speakable selector
      points at it — and the form comes straight after.
  
      ONE PER PAGE. The GHL loader binds to its iframe by id, so a second
      copy would break both; the CTA at the foot no longer carries one and
      keeps its phone button. The sticky mobile bar jumps to this. */}
  <LeadForm />

  {/* THE JOB PHOTO, where the page turns from the offer to the work. Not every
      service has one: the photo library reflects what this company actually
      gets called out for, so crawlspaces, rodents, wasps and exclusion are
      well covered and silverfish and centipedes have nothing at all. A page
      without a photograph renders without one rather than borrowing a stock
      image of somebody else's job. */}
  {servicePhotos[s.slug] && <Photo photo={servicePhotos[s.slug]} />}

  {/* TRAINING, ON THE THREE PAGES IT ACTUALLY BEARS ON. Insulation courses
      belong on the insulation and crawlspace pages; the air-sealing course
      belongs on exclusion, because air sealing and rodent exclusion are the
      same skill pointed at two outcomes. Putting the block on all 23 service
      pages would make it furniture and would be claiming relevance it does
      not have on, say, the spider page. Each page is filtered to the courses
      that are about its own subject. */}
  {s.slug === 'attic-insulation' && (
    <Training only={['attic', 'air sealing', 'wall', 'roof/ceiling']} />
  )}
  {s.slug === 'crawlspace-restoration' && (
    <Training only={['floor', 'belly', 'air sealing', 'fiber glass']} />
  )}
  {s.slug === 'exclusion-and-repairs' && (
    <>
      <Training
        only={['air sealing']}
        heading="Air sealing is the same skill as exclusion"
      />
      <Training installers heading="Product certifications we hold" />
    </>
  )}

  {/* RidgeGuard is an exclusion product, so it belongs on the rodent page too
      — that is the service most readers arrive at it through. */}
  {s.slug === 'rodent-control' && (
    <Training installers heading="Product certifications we hold" />
  )}

  {Body ? (
    <div class="prose"><Body /></div>
  ) : (
    <div class="stub">
      <b>Route live, content pending.</b> This page is generated from
      <code>src/data/services.ts</code> and is marked <code>noindex</code> until a
      writer files <code>src/content/services/{s.slug}.md</code> clearing the
      3,000-word floor. Category: {categories[s.category]}.
    </div>
  )}

  <ExpertBlock slug={entry?.data.expert} />

  {problems.length > 0 && (
    <LinkRail heading={`Common ${s.short.toLowerCase()} problems we get called for`} links={problems} />
  )}

  <Faq items={faqs} />

  <LinkRail heading={`Related ${categories[s.category].toLowerCase()} services`} links={siblings} />

  <LinkRail heading="Guides" links={guideLinks} />

  <Cta market="Whatcom County" service={s.name} serviceSlug={s.slug} />
</BaseLayout>
