---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBox from '../../../components/AnswerBox.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Photo from '../../../components/Photo.astro';
import Training from '../../../components/Training.astro';
import EntryPoints from '../../../components/EntryPoints.astro';
import Video from '../../../components/Video.astro';
import { videoForService } from '../../../data/videos';
import { servicePhotos } from '../../../data/photos';
import Faq from '../../../components/Faq.astro';
import Cta from '../../../components/Cta.astro';
import LinkRail from '../../../components/LinkRail.astro';
import { guideLinksFor } from '../../../lib/guides';
import { blogPostsFor } from '../../../lib/blog';
import { galleryFor } from '../../../data/gallery';
import { garageDoorSeal } from '../../../data/photos';
import ExpertBlock from '../../../components/ExpertBlock.astro';
import { liveServices, categories } from '../../../data/services';
import { business } from '../../../data/business';

export async function getStaticPaths() {
  /* Programmatic routing off the data file. Anything off-list 404s cleanly —
     no accidental thin pages. Unconfirmed services never enumerate. */
  return liveServices().map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const path = `/services/${s.slug}/`;

/* Render the markdown body when it exists, fall back to a generated stub.
   All routes stand up first; content pours in waves without a broken site. */
const entries = await getCollection('services', (e) => e.data.service === s.slug);
const entry = entries[0];
const Body = entry ? (await entry.render()).Content : null;
const ready = entry?.data.ready === true;

const title = entry?.data.title ?? `${s.name} in Bellingham, WA`;
const description =
  entry?.data.description ??
  `${s.name} for homes and businesses across Whatcom and Skagit County. No long-term contracts and a 100% Service Guarantee on every treatment.`;
const h1 = entry?.data.h1 ?? `${s.name} in Bellingham & Whatcom County`;
const answer = entry?.data.answer ?? null;
const faqs = entry?.data.faqs ?? [];

const siblings = liveServices()
  .filter((x) => x.category === s.category && x.slug !== s.slug)
  .map((x) => ({ href: `/services/${x.slug}/`, label: x.name }));

const problems = (s.problems ?? []).map((p) => ({
  href: `${path}${p.slug}/`,
  label: p.title,
}));

/* Related guides, resolved from the guides' own relatedTo declarations —
   one list, queried, rather than a second list maintained here. */
const guideLinks = await guideLinksFor(path);
/* Posts whose topic this page owns. Fifty-six imported posts declared a
   supersededBy target and no target had ever linked back, which left most of
   the blog with one inbound link in the whole site. */
const blogLinks = await blogPostsFor(path);

/* Six of the nine gallery sections belong to a service spoke. See the note in
   src/data/gallery.ts on why they attach here rather than becoming pages. */
const photos = galleryFor(s.slug);
---
<BaseLayout
  videoKey={videoForService[s.slug]}
  path={path}
  title={title}
  description={description}
  kind="service"
  serviceName={s.name}
  noindex={!ready}
  {/* The AnswerBox only renders once the markdown body lands, so the speakable
      selector naming it must be conditional too — see src/lib/schema.ts. */}
  hasAnswer={Boolean(answer)}
  faqs={faqs}
  image={entry?.data.hero}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: s.short, path },
  ]}
>
  <h1>{h1}</h1>

  {answer && <AnswerBox text={answer} />}

  {/* THE LEAD FORM SITS HERE, HIGH, and the position is the point.
      It used to hang off the foot of Cta.astro, which put it under three
      thousand words: a reader who had already decided to act had to scroll
      an entire article to find anything to act on. The quick answer still
      leads — it is one short paragraph and the schema's speakable selector
      points at it — and the form comes straight after.
  
      ONE PER PAGE. The GHL loader binds to its iframe by id, so a second
      copy would break both; the CTA at the foot no longer carries one and
      keeps its phone button. The sticky mobile bar jumps to this. */}
  <LeadForm />

  {/* THE JOB PHOTO, where the page turns from the offer to the work. Not every
      service has one: the photo library reflects what this company actually
      gets called out for, so crawlspaces, rodents, wasps and exclusion are
      well covered and silverfish and centipedes have nothing at all. A page
      without a photograph renders without one rather than borrowing a stock
      image of somebody else's job. */}
  {servicePhotos[s.slug] && <Photo photo={servicePhotos[s.slug]} />}

  {/* TRAINING, ON THE THREE PAGES IT ACTUALLY BEARS ON. Insulation courses
      belong on the insulation and crawlspace pages; the air-sealing course
      belongs on exclusion, because air sealing and rodent exclusion are the
      same skill pointed at two outcomes. Putting the block on all 23 service
      pages would make it furniture and would be claiming relevance it does
      not have on, say, the spider page. Each page is filtered to the courses
      that are about its own subject. */}
  {s.slug === 'attic-insulation' && (
    <Training only={['attic', 'air sealing', 'wall', 'roof/ceiling']} />
  )}
  {s.slug === 'crawlspace-restoration' && (
    <Training only={['floor', 'belly', 'air sealing', 'fiber glass']} />
  )}
  {s.slug === 'exclusion-and-repairs' && (
    <>
      {/* Heading rewritten 2 Sep 2026. It read "Air sealing is the same skill
          as exclusion", which was true about the skill and wrong about the
          offer — the owner does not sell air sealing and a heading like that
          on a service page reads as a service. The training is still worth
          showing here, because it is why we can tell a sealed building from an
          unsealed one; it is just not a thing to buy from us. */}
      <Training
        only={['air sealing']}
        heading="Related training we hold"
      />
      <Training installers heading="Product certifications we hold" />
    </>
  )}

  {/* RidgeGuard is an exclusion product, so it belongs on the rodent page too
      — that is the service most readers arrive at it through. */}
  {s.slug === 'rodent-control' && (
    <Training installers heading="Product certifications we hold" />
  )}

  {s.slug === 'rodent-control' && (
    <Video name={videoForService[s.slug]} heading="The autumn move indoors, on video" />
  )}

  {/* THE ENTRY DIAGRAM, on the two pages it is an argument for. Rodent control
      is where a reader asks "how did they get in"; exclusion is where they ask
      "what would you actually seal". Same drawing, different question, so the
      heading changes and the drawing does not. It is deliberately NOT on the
      other 21 service pages — a spider page does not need a rodent diagram,
      and furniture is what this becomes if it goes everywhere. */}
  {s.slug === 'rodent-control' && <EntryPoints heading="Where they actually get in" />}

  {/* THE COMPANY'S OWN VIDEOS, on the four pages they are about. Nothing
      loads from YouTube until a reader presses play — see Video.astro. They
      go on the service pages rather than a "videos" page nobody visits,
      because a video about carpenter ants is worth something to the person
      reading about carpenter ants and nothing to anybody else. */}
  {videoForService[s.slug] && s.slug !== 'rodent-control' && (
    <Video name={videoForService[s.slug]} heading={`${s.short}, on video`} />
  )}
  {s.slug === 'exclusion-and-repairs' && (
    <EntryPoints heading="What we seal, and where it is" />
  )}

  {Body ? (
    <div class="prose"><Body /></div>
  ) : (
    <div class="stub">
      <b>Route live, content pending.</b> This page is generated from
      <code>src/data/services.ts</code> and is marked <code>noindex</code> until a
      writer files <code>src/content/services/{s.slug}.md</code> clearing the
      3,000-word floor. Category: {categories[s.category]}.
    </div>
  )}

  <ExpertBlock slug={entry?.data.expert} />

  {problems.length > 0 && (
    <LinkRail heading={`Common ${s.short.toLowerCase()} problems we get called for`} links={problems} />
  )}

  <Faq items={faqs} />

  <LinkRail heading={`Related ${categories[s.category].toLowerCase()} services`} links={siblings} />

  <LinkRail heading="Guides" links={guideLinks} />

  {/* data-boilerplate, and it has to be. The paragraph below is identical on
      all six pages that carry a gallery, which is exactly what the
      duplicate-sentence scanner exists to catch — it failed on it, correctly,
      the first time this shipped. The right answer is not six reworded
      variants of one claim, which is padding; it is to classify the block as
      what it is. Furniture repeated across pages does not count toward a word
      floor, the same rule the lead form and the map already sit under.

      No nested <section> inside this one: the harness strips boilerplate with
      a non-greedy tag-backreferenced regex, so a section within a section
      would truncate the strip at the wrong closing tag. */}
  {/* The before-and-after, on the one page where it is the argument. Not
      data-boilerplate: it appears on a single page, and its caption is that
      page's content. */}
  {s.slug === 'exclusion-and-repairs' && (
    <section>
      <h2>The same door, before and after</h2>
      <div class="gallery pair">
        <img src={garageDoorSeal.before.file} alt={garageDoorSeal.before.alt} width={1300} height={975} loading="lazy" decoding="async" />
        <img src={garageDoorSeal.after.file} alt={garageDoorSeal.after.alt} width={1300} height={975} loading="lazy" decoding="async" />
      </div>
      <p class="prose">{garageDoorSeal.caption}</p>
    </section>
  )}

  {photos && (
    <section data-boilerplate>
      <h2>{photos.title}: {photos.images.length} photographs from real jobs</h2>
      <div class="prose">
        <p>
          Every one of these was taken on a job in Whatcom or Skagit County by
          whoever was doing the work. Stock photography is close to universal
          in this trade and a reader has no way to tell by looking, which is
          the only reason it is worth saying out loud. The rest of the archive
          is on the <a href="/gallery/">gallery</a>.
        </p>
      </div>
      <div class="gallery">
        {photos.images.map((img) => (
          <img
            src={img.file}
            alt={img.alt}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </section>
  )}

  {blogLinks.length > 0 && <LinkRail heading="From the blog" links={blogLinks} />}

  <Cta market="Whatcom County" service={s.name} serviceSlug={s.slug} />
</BaseLayout>
