---
import InlinePhoto from '../components/InlinePhoto.astro';
import { inlinePhotosFor } from '../lib/page-photos';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import { business } from '../data/business';

const path = '/network/';

/* This is the legacy /locations/ brand-network content. The new taxonomy
   claims /locations/ for the geo hub, so this content moved here.
   Keystone Part 14 — site separation is absolute: we link to the Texas
   franchise, we do not reproduce its NAP, photos or license here. */
const answer =
  'Sasquatch Pest Control is headquartered in Bellingham, Washington, serving Whatcom County, and there is a separately operated Sasquatch franchise serving the greater Houston, Texas area. Each location is licensed, staffed and scheduled independently in its own market.';
/* Photographs through the text (owner, 19 Sep 2026). */
const inlinePhotos = inlinePhotosFor('/network/');
---
<BaseLayout
  path={path}
  leadForm={false}
  title="Our Locations & Network"
  description="Sasquatch Pest Control is headquartered in Bellingham, Washington, with a separately operated franchise serving the greater Houston, Texas area."
  kind="page"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Our network', path }]}
>
  <h1>Our Locations &amp; Network</h1>
  <AnswerBox text={answer} />

  <div class="prose">
    <h2>Bellingham, Washington — headquarters</h2>
    <p>
      {business.address.street}, {business.address.locality}, {business.address.region}{' '}
      {business.address.postalCode}. Serving Whatcom County.
      <br /><a href="/locations/">See our Washington service areas</a>
    </p>

    <h2>Greater Houston, Texas</h2>
    <p>
      A separately operated Sasquatch franchise serves the greater Houston area.
      It is licensed and scheduled independently — for service in Texas, contact
      that location directly at{' '}
      <a href="https://sasquatchpestcontroltx.com/" rel="noopener">
        sasquatchpestcontroltx.com
      </a>{' '}or <a href="tel:+12816274810">281-627-4810</a>.
    </p>
    {/* THE TEXAS MARK, owner's call 20 Sep 2026: "Use this for our Texas
        franchise link." Their artwork, not ours, so it is stored under
        /img/network/ rather than in the gallery, which holds photographs of
        this company's own work. The number beside it is theirs as well — it is
        a tel: link like every other number on this site, and it is nowhere in
        the schema, which carries Bellingham's number alone. */}
    <figure class="franchise">
      <a href="https://sasquatchpestcontroltx.com/" rel="noopener">
        <img
          src="/img/network/sasquatch-pest-control-houston-texas.jpg"
          alt="Sasquatch Pest Control Houston, Texas — the brand mark inside the outline of Texas over the Houston skyline, with the Texas phone number and web address"
          width="800"
          height="802"
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>
        The Houston location's own mark. It is a separate business with its own
        licensing, crews and schedule; this page is the link to it, not a way to
        book it through us.
      </figcaption>
    </figure>
  {inlinePhotos[0] && <InlinePhoto photo={inlinePhotos[0]} />}

    <h2>One brand, one standard</h2>
    <p>
      Each location runs on the same service standard and the same guarantee
      structure, and each is accountable in its own market.
    </p>
  </div>
</BaseLayout>
