---
import { inlineLinks } from '../../../lib/inline-links';
import InlinePhoto from '../../../components/InlinePhoto.astro';
import { inlinePhotosForEs } from '../../../lib/page-photos-es';
import { photoForSection } from '../../../lib/page-photos';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { serviceGroups } from '../../../lib/menus';
import AnswerBox from '../../../components/AnswerBox.astro';
import QuickFacts from '../../../components/QuickFacts.astro';
import QuickNav from '../../../components/QuickNav.astro';
import Faq from '../../../components/Faq.astro';
import LinkRail from '../../../components/LinkRail.astro';
import { business } from '../../../data/business';
import { esServicios } from '../../../data/es-servicios';
import { esGiros, esGiroPath } from '../../../data/es-comercial';
import { esProblemas, esProblemaPath } from '../../../data/es-problemas';
import { t } from '../../../data/i18n';

export function getStaticPaths() {
  return esServicios.map((s) => ({ params: { servicio: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const path = `/es/servicios/${s.slug}/`;
const S = t('es');

/* El riel de enlaces apunta solo a páginas en español que existen. Mandar a
   un lector hispanohablante al inglés desde un riel "relacionado" es
   exactamente la deriva que este alcance se trazó para evitar. */
const rails = esServicios
  .filter((o) => o.slug !== s.slug)
  .map((o) => ({ href: `/es/servicios/${o.slug}/`, label: o.h1.replace(/ en Bellingham.*$/i, '') }));
/* Photographs through the text, the English twin's (owner, 19 Sep 2026). */
const fotos = inlinePhotosForEs(Astro.url.pathname);
---
<BaseLayout
  source={`src/data/es-servicios/${s.slug}.ts`}
  path={path}
  lang="es"
  title={s.title}
  description={s.description}
  kind="page"
  breadcrumbs={[
    { name: 'Inicio', path: '/es/' },
    { name: 'Servicios', path: '/es/servicios/' },
    { name: s.nav, path },
  ]}
>
  <h1>{s.h1}</h1>
  <AnswerBox text={s.answer} />

  <QuickNav rails={[
    /* Los problemas de este servicio que ya tienen página en español. */
    {
      heading: 'Problemas que atendemos',
      links: esProblemas
        .filter((p) => `/services/${p.service}/` === s.enPath)
        .map((p) => ({ href: esProblemaPath(p), label: p.nav })),
    },
    /* Solo en el servicio comercial: sus industrias, en español. */
    s.slug === 'control-de-plagas-comercial' && {
      heading: 'Programas por industria',
      links: [{ href: '/es/comercial/', label: 'Todo el control de plagas comercial' }, ...esGiros.map((g) => ({ href: esGiroPath(g), label: g.nav }))],
    },
    { heading: 'Otros servicios', groups: serviceGroups('es', path) },
  ]} />

  {/* Keystone v3.2 §4.3 — ver QuickFacts.astro. */}
  {s.tabla && <QuickFacts heading={`${s.nav ?? s.h1}: el trabajo de un vistazo`} rows={s.tabla} />}

  <div class="prose">
    {s.secciones.map((sec, i) => (
      <>
        <h2>{sec.h2}</h2>
        {sec.parrafos.map((p, j) => (
          <>
            <p set:html={inlineLinks(p)} />
            {j === 0 && photoForSection(fotos, i) && <InlinePhoto photo={photoForSection(fotos, i)!} lang="es" />}
          </>
        ))}
      </>
    ))}

    <div data-boilerplate>
    <h2>Pida una inspección</h2>
    <p>
      Llame o mande un mensaje de texto al{' '}
      <a href={`tel:${business.phoneE164}`}>{business.phone}</a>. Hablamos
      español. También puede{' '}
      <a href="/es/contacto/">escribirnos desde la página de contacto</a>.
    </p>
    </div>
  </div>

  <Faq items={s.faqs} />

  <p class="prose" data-boilerplate>{S.englishOnwardNote}</p>
</BaseLayout>
